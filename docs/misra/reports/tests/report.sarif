{ "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json", "version": "2.1.0", "runs": [ {"tool": { "driver": {"name": "C/C++test","semanticVersion": "2026.1.3","rules": [{ "id": "MISRAC2025-RULE_20_9-b", "name": "Do not use in preprocessor directives #if and #elif macros not defined in translation unit", "shortDescription": { "text": "Do not use in preprocessor directives #if and #elif macros not defined in translation unit" }, "fullDescription": { "text": "Do not use in preprocessor directives #if and #elif macros not defined in translation unit [MISRAC2025-RULE_20_9-b]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "Do not use in preprocessor directives #if and #elif macros not defined in translation unit [MISRAC2025-RULE_20_9-b]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 20.9 (Required) All identifiers used in the controlling expression of #if or #elif preprocessing directives shall be #define'd before evaluation" ] } }, { "id": "MISRAC2025-RULE_2_2-b", "name": "Avoid unused values", "shortDescription": { "text": "Avoid unused values" }, "fullDescription": { "text": "Avoid unused values [MISRAC2025-RULE_2_2-b]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "Avoid unused values [MISRAC2025-RULE_2_2-b]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 2.2 (Required) A project shall not contain dead code" ] } }, { "id": "MISRAC2025-RULE_5_10-a", "name": "The names of standard library macros, objects and functions shall not be reused", "shortDescription": { "text": "The names of standard library macros, objects and functions shall not be reused" }, "fullDescription": { "text": "The names of standard library macros, objects and functions shall not be reused [MISRAC2025-RULE_5_10-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The names of standard library macros, objects and functions shall not be reused [MISRAC2025-RULE_5_10-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 5.10 (Required) A reserved identifier or reserved macro name shall not be declared" ] } }, { "id": "MISRAC2025-RULE_5_10-b", "name": "The names of standard library macros, objects and functions shall not be reused (C90)", "shortDescription": { "text": "The names of standard library macros, objects and functions shall not be reused (C90)" }, "fullDescription": { "text": "The names of standard library macros, objects and functions shall not be reused (C90) [MISRAC2025-RULE_5_10-b]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The names of standard library macros, objects and functions shall not be reused (C90) [MISRAC2025-RULE_5_10-b]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 5.10 (Required) A reserved identifier or reserved macro name shall not be declared" ] } }, { "id": "MISRAC2025-RULE_5_10-c", "name": "The names of standard library macros, objects and functions shall not be reused (C99)", "shortDescription": { "text": "The names of standard library macros, objects and functions shall not be reused (C99)" }, "fullDescription": { "text": "The names of standard library macros, objects and functions shall not be reused (C99) [MISRAC2025-RULE_5_10-c]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The names of standard library macros, objects and functions shall not be reused (C99) [MISRAC2025-RULE_5_10-c]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 5.10 (Required) A reserved identifier or reserved macro name shall not be declared" ] } }, { "id": "MISRAC2025-RULE_2_5-a", "name": "A source file should not contain unused macro definitions", "shortDescription": { "text": "A source file should not contain unused macro definitions" }, "fullDescription": { "text": "A source file should not contain unused macro definitions [MISRAC2025-RULE_2_5-a]" }, "defaultConfiguration": { "level": "warning" }, "help": { "text": "A source file should not contain unused macro definitions [MISRAC2025-RULE_2_5-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 2.5 (Advisory) A project should not contain unused macro definitions" ] } }, { "id": "MISRAC2025-RULE_2_4-b", "name": "A source file should not contain unused tag declarations", "shortDescription": { "text": "A source file should not contain unused tag declarations" }, "fullDescription": { "text": "A source file should not contain unused tag declarations [MISRAC2025-RULE_2_4-b]" }, "defaultConfiguration": { "level": "warning" }, "help": { "text": "A source file should not contain unused tag declarations [MISRAC2025-RULE_2_4-b]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 2.4 (Advisory) A project should not contain unused tag declarations" ] } }, { "id": "MISRAC2025-RULE_20_10-a", "name": "The # and ## preprocessor operators should not be used", "shortDescription": { "text": "The # and ## preprocessor operators should not be used" }, "fullDescription": { "text": "The # and ## preprocessor operators should not be used [MISRAC2025-RULE_20_10-a]" }, "defaultConfiguration": { "level": "warning" }, "help": { "text": "The # and ## preprocessor operators should not be used [MISRAC2025-RULE_20_10-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 20.10 (Advisory) The # and ## preprocessor operators should not be used" ] } }, { "id": "MISRAC2025-RULE_20_1-a", "name": "#include statements in a file should only be preceded by other preprocessor directives or comments", "shortDescription": { "text": "#include statements in a file should only be preceded by other preprocessor directives or comments" }, "fullDescription": { "text": "#include statements in a file should only be preceded by other preprocessor directives or comments [MISRAC2025-RULE_20_1-a]" }, "defaultConfiguration": { "level": "warning" }, "help": { "text": "#include statements in a file should only be preceded by other preprocessor directives or comments [MISRAC2025-RULE_20_1-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 20.1 (Advisory) #include directives should only be preceded by preprocessor directives or comments" ] } }, { "id": "MISRAC2025-RULE_2_8-a", "name": "A project should not contain unused variables with external linkage", "shortDescription": { "text": "A project should not contain unused variables with external linkage" }, "fullDescription": { "text": "A project should not contain unused variables with external linkage [MISRAC2025-RULE_2_8-a]" }, "defaultConfiguration": { "level": "warning" }, "help": { "text": "A project should not contain unused variables with external linkage [MISRAC2025-RULE_2_8-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 2.8 (Advisory) A project should not contain unused object definitions" ] } }, { "id": "MISRAC2025-RULE_2_7-a", "name": "There should be no unused parameters in functions", "shortDescription": { "text": "There should be no unused parameters in functions" }, "fullDescription": { "text": "There should be no unused parameters in functions [MISRAC2025-RULE_2_7-a]" }, "defaultConfiguration": { "level": "warning" }, "help": { "text": "There should be no unused parameters in functions [MISRAC2025-RULE_2_7-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 2.7 (Advisory) A function should not contain unused parameters" ] } }, { "id": "MISRAC2025-RULE_17_1-a", "name": "The identifiers va_list, va_arg, va_start, va_end, va_copy should not be used", "shortDescription": { "text": "The identifiers va_list, va_arg, va_start, va_end, va_copy should not be used" }, "fullDescription": { "text": "The identifiers va_list, va_arg, va_start, va_end, va_copy should not be used [MISRAC2025-RULE_17_1-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The identifiers va_list, va_arg, va_start, va_end, va_copy should not be used [MISRAC2025-RULE_17_1-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 17.1 (Required) The standard header file <stdarg.h> shall not be used" ] } }, { "id": "MISRAC2025-RULE_17_1-b", "name": "The identifiers va_list, va_arg, va_start, va_end should not be used", "shortDescription": { "text": "The identifiers va_list, va_arg, va_start, va_end should not be used" }, "fullDescription": { "text": "The identifiers va_list, va_arg, va_start, va_end should not be used [MISRAC2025-RULE_17_1-b]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The identifiers va_list, va_arg, va_start, va_end should not be used [MISRAC2025-RULE_17_1-b]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 17.1 (Required) The standard header file <stdarg.h> shall not be used" ] } }, { "id": "MISRAC2025-RULE_17_1-c", "name": "The standard header file <stdarg.h> or <cstdarg> shall not be used", "shortDescription": { "text": "The standard header file <stdarg.h> or <cstdarg> shall not be used" }, "fullDescription": { "text": "The standard header file <stdarg.h> or <cstdarg> shall not be used [MISRAC2025-RULE_17_1-c]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The standard header file <stdarg.h> or <cstdarg> shall not be used [MISRAC2025-RULE_17_1-c]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 17.1 (Required) The standard header file <stdarg.h> shall not be used" ] } }, { "id": "MISRAC2025-RULE_17_7-a", "name": "The value returned by a function having non-void return type shall be used", "shortDescription": { "text": "The value returned by a function having non-void return type shall be used" }, "fullDescription": { "text": "The value returned by a function having non-void return type shall be used [MISRAC2025-RULE_17_7-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The value returned by a function having non-void return type shall be used [MISRAC2025-RULE_17_7-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 17.7 (Required) The value returned by a function having non-void return type shall be used" ] } }, { "id": "MISRAC2025-RULE_17_8-a", "name": "A function parameter should not be modified", "shortDescription": { "text": "A function parameter should not be modified" }, "fullDescription": { "text": "A function parameter should not be modified [MISRAC2025-RULE_17_8-a]" }, "defaultConfiguration": { "level": "warning" }, "help": { "text": "A function parameter should not be modified [MISRAC2025-RULE_17_8-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 17.8 (Advisory) A function parameter should not be modified" ] } }, { "id": "MISRAC2025-RULE_21_6-a", "name": "The input\/output functions from the 'cstdio' and 'cwchar' libraries should not be used", "shortDescription": { "text": "The input\/output functions from the 'cstdio' and 'cwchar' libraries should not be used" }, "fullDescription": { "text": "The input\/output functions from the 'cstdio' and 'cwchar' libraries should not be used [MISRAC2025-RULE_21_6-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The input\/output functions from the 'cstdio' and 'cwchar' libraries should not be used [MISRAC2025-RULE_21_6-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 21.6 (Required) The Standard Library input\/output functions shall not be used" ] } }, { "id": "MISRAC2025-RULE_21_8-b", "name": "The 'exit()' function from the 'stdlib.h' or 'cstdlib' library shall not be used", "shortDescription": { "text": "The 'exit()' function from the 'stdlib.h' or 'cstdlib' library shall not be used" }, "fullDescription": { "text": "The 'exit()' function from the 'stdlib.h' or 'cstdlib' library shall not be used [MISRAC2025-RULE_21_8-b]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The 'exit()' function from the 'stdlib.h' or 'cstdlib' library shall not be used [MISRAC2025-RULE_21_8-b]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 21.8 (Required) The Standard Library termination functions of <stdlib.h> shall not be used" ] } }, { "id": "MISRAC2025-RULE_10_3-a", "name": "The value of an expression shall not be assigned to an object with a narrower essential type", "shortDescription": { "text": "The value of an expression shall not be assigned to an object with a narrower essential type" }, "fullDescription": { "text": "The value of an expression shall not be assigned to an object with a narrower essential type [MISRAC2025-RULE_10_3-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The value of an expression shall not be assigned to an object with a narrower essential type [MISRAC2025-RULE_10_3-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 10.3 (Required) The value of an expression shall not be assigned to an object with a narrower essential type or of a different essential type category" ] } }, { "id": "MISRAC2025-RULE_10_3-b", "name": "The value of an expression shall not be assigned to an object of a different essential type category", "shortDescription": { "text": "The value of an expression shall not be assigned to an object of a different essential type category" }, "fullDescription": { "text": "The value of an expression shall not be assigned to an object of a different essential type category [MISRAC2025-RULE_10_3-b]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The value of an expression shall not be assigned to an object of a different essential type category [MISRAC2025-RULE_10_3-b]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 10.3 (Required) The value of an expression shall not be assigned to an object with a narrower essential type or of a different essential type category" ] } }, { "id": "MISRAC2025-RULE_10_4-a", "name": "Both operands of an operator in which the usual arithmetic conversions are performed shall have the same essential type category", "shortDescription": { "text": "Both operands of an operator in which the usual arithmetic conversions are performed shall have the same essential type category" }, "fullDescription": { "text": "Both operands of an operator in which the usual arithmetic conversions are performed shall have the same essential type category [MISRAC2025-RULE_10_4-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "Both operands of an operator in which the usual arithmetic conversions are performed shall have the same essential type category [MISRAC2025-RULE_10_4-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 10.4 (Required) Both operands of an operator in which the usual arithmetic conversions are performed shall have the same essential type category" ] } }, { "id": "MISRAC2025-RULE_10_7-a", "name": "If a composite expression is used as one operand of an operator in which the usual arithmetic conversions are performed then the other operand shall not have wider essential type", "shortDescription": { "text": "If a composite expression is used as one operand of an operator in which the usual arithmetic conversions are performed then the other operand shall not have wider essential type" }, "fullDescription": { "text": "If a composite expression is used as one operand of an operator in which the usual arithmetic conversions are performed then the other operand shall not have wider essential type [MISRAC2025-RULE_10_7-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "If a composite expression is used as one operand of an operator in which the usual arithmetic conversions are performed then the other operand shall not have wider essential type [MISRAC2025-RULE_10_7-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 10.7 (Required) If a composite expression is used as one operand of an operator in which the usual arithmetic conversions are performed then the other operand shall not have wider essential type" ] } }, { "id": "MISRAC2025-RULE_10_8-a", "name": "The value of a composite expression shall not be cast to a different essential type category or a wider essential type", "shortDescription": { "text": "The value of a composite expression shall not be cast to a different essential type category or a wider essential type" }, "fullDescription": { "text": "The value of a composite expression shall not be cast to a different essential type category or a wider essential type [MISRAC2025-RULE_10_8-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The value of a composite expression shall not be cast to a different essential type category or a wider essential type [MISRAC2025-RULE_10_8-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 10.8 (Required) The value of a composite expression shall not be cast to a different essential type category or a wider essential type" ] } }, { "id": "MISRAC2025-RULE_18_1-c", "name": "A pointer operand and any pointer resulting from pointer arithmetic using that operand shall both address elements of the same array", "shortDescription": { "text": "A pointer operand and any pointer resulting from pointer arithmetic using that operand shall both address elements of the same array" }, "fullDescription": { "text": "A pointer operand and any pointer resulting from pointer arithmetic using that operand shall both address elements of the same array [MISRAC2025-RULE_18_1-c]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "A pointer operand and any pointer resulting from pointer arithmetic using that operand shall both address elements of the same array [MISRAC2025-RULE_18_1-c]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 18.1 (Required) A pointer resulting from arithmetic on a pointer operand shall address an element of the same array as that pointer operand" ] } }, { "id": "MISRAC2025-RULE_18_2-a", "name": "Do not subtract two pointers that do not address elements of the same array", "shortDescription": { "text": "Do not subtract two pointers that do not address elements of the same array" }, "fullDescription": { "text": "Do not subtract two pointers that do not address elements of the same array [MISRAC2025-RULE_18_2-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "Do not subtract two pointers that do not address elements of the same array [MISRAC2025-RULE_18_2-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 18.2 (Required) Subtraction between pointers shall only be applied to pointers that address elements of the same array" ] } }, { "id": "MISRAC2025-RULE_18_3-a", "name": "Do not compare two unrelated pointers", "shortDescription": { "text": "Do not compare two unrelated pointers" }, "fullDescription": { "text": "Do not compare two unrelated pointers [MISRAC2025-RULE_18_3-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "Do not compare two unrelated pointers [MISRAC2025-RULE_18_3-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 18.3 (Required) The relational operators >, >=, < and <= shall not be applied to expressions of pointer type except where they point into the same object" ] } }, { "id": "MISRAC2025-RULE_18_4-a", "name": "The +, -, += and -= operators should not be applied to an expression of pointer type", "shortDescription": { "text": "The +, -, += and -= operators should not be applied to an expression of pointer type" }, "fullDescription": { "text": "The +, -, += and -= operators should not be applied to an expression of pointer type [MISRAC2025-RULE_18_4-a]" }, "defaultConfiguration": { "level": "warning" }, "help": { "text": "The +, -, += and -= operators should not be applied to an expression of pointer type [MISRAC2025-RULE_18_4-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 18.4 (Advisory) The +, -, += and -= operators should not be applied to an expression of pointer type" ] } }, { "id": "MISRAC2025-RULE_18_6-b", "name": "The address of an object with automatic storage shall not be assigned to another object that may persist after the first object has ceased to exist", "shortDescription": { "text": "The address of an object with automatic storage shall not be assigned to another object that may persist after the first object has ceased to exist" }, "fullDescription": { "text": "The address of an object with automatic storage shall not be assigned to another object that may persist after the first object has ceased to exist [MISRAC2025-RULE_18_6-b]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The address of an object with automatic storage shall not be assigned to another object that may persist after the first object has ceased to exist [MISRAC2025-RULE_18_6-b]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 18.6 (Required) The address of an object with automatic or thread-local storage shall not be copied to another object that persists after the first object has ceased to exist" ] } }, { "id": "MISRAC2025-RULE_21_10-a", "name": "The standard header files <time.h> or <ctime> shall not be used", "shortDescription": { "text": "The standard header files <time.h> or <ctime> shall not be used" }, "fullDescription": { "text": "The standard header files <time.h> or <ctime> shall not be used [MISRAC2025-RULE_21_10-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The standard header files <time.h> or <ctime> shall not be used [MISRAC2025-RULE_21_10-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 21.10 (Required) The Standard Library time and date functions shall not be used" ] } }, { "id": "MISRAC2025-RULE_21_10-b", "name": "The time handling functions and macros of the library <time.h> shall not be used", "shortDescription": { "text": "The time handling functions and macros of the library <time.h> shall not be used" }, "fullDescription": { "text": "The time handling functions and macros of the library <time.h> shall not be used [MISRAC2025-RULE_21_10-b]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The time handling functions and macros of the library <time.h> shall not be used [MISRAC2025-RULE_21_10-b]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 21.10 (Required) The Standard Library time and date functions shall not be used" ] } }, { "id": "MISRAC2025-RULE_21_10-c", "name": "The types defined in the library <time.h> shall not be used", "shortDescription": { "text": "The types defined in the library <time.h> shall not be used" }, "fullDescription": { "text": "The types defined in the library <time.h> shall not be used [MISRAC2025-RULE_21_10-c]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The types defined in the library <time.h> shall not be used [MISRAC2025-RULE_21_10-c]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 21.10 (Required) The Standard Library time and date functions shall not be used" ] } }, { "id": "MISRAC2025-RULE_10_1-a", "name": "An expression of essentially Boolean type should always be used where an operand is interpreted as a Boolean value", "shortDescription": { "text": "An expression of essentially Boolean type should always be used where an operand is interpreted as a Boolean value" }, "fullDescription": { "text": "An expression of essentially Boolean type should always be used where an operand is interpreted as a Boolean value [MISRAC2025-RULE_10_1-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "An expression of essentially Boolean type should always be used where an operand is interpreted as a Boolean value [MISRAC2025-RULE_10_1-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 10.1 (Required) Operands shall not be of an inappropriate essential type" ] } }, { "id": "MISRAC2025-RULE_10_1-e", "name": "Shift and bitwise operations should not be performed on operands of essentially signed or enum type", "shortDescription": { "text": "Shift and bitwise operations should not be performed on operands of essentially signed or enum type" }, "fullDescription": { "text": "Shift and bitwise operations should not be performed on operands of essentially signed or enum type [MISRAC2025-RULE_10_1-e]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "Shift and bitwise operations should not be performed on operands of essentially signed or enum type [MISRAC2025-RULE_10_1-e]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 10.1 (Required) Operands shall not be of an inappropriate essential type" ] } }, { "id": "MISRAC2025-RULE_8_7-a", "name": "Functions and objects should not be defined with external linkage if they are referenced in only one translation unit", "shortDescription": { "text": "Functions and objects should not be defined with external linkage if they are referenced in only one translation unit" }, "fullDescription": { "text": "Functions and objects should not be defined with external linkage if they are referenced in only one translation unit [MISRAC2025-RULE_8_7-a]" }, "defaultConfiguration": { "level": "warning" }, "help": { "text": "Functions and objects should not be defined with external linkage if they are referenced in only one translation unit [MISRAC2025-RULE_8_7-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 8.7 (Advisory) Functions and objects should not be defined with external linkage if they are referenced in only one translation unit" ] } }, { "id": "MISRAC2025-RULE_8_6-a", "name": "An identifier with external linkage shall have no more then one external definition", "shortDescription": { "text": "An identifier with external linkage shall have no more then one external definition" }, "fullDescription": { "text": "An identifier with external linkage shall have no more then one external definition [MISRAC2025-RULE_8_6-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "An identifier with external linkage shall have no more then one external definition [MISRAC2025-RULE_8_6-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 8.6 (Required) An identifier with external linkage shall have exactly one external definition" ] } }, { "id": "MISRAC2025-RULE_8_6-b", "name": "An identifier with external linkage shall have external definition", "shortDescription": { "text": "An identifier with external linkage shall have external definition" }, "fullDescription": { "text": "An identifier with external linkage shall have external definition [MISRAC2025-RULE_8_6-b]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "An identifier with external linkage shall have external definition [MISRAC2025-RULE_8_6-b]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 8.6 (Required) An identifier with external linkage shall have exactly one external definition" ] } }, { "id": "MISRAC2025-RULE_8_9-a", "name": "Objects shall be defined at block scope if they are only accessed from within a single function", "shortDescription": { "text": "Objects shall be defined at block scope if they are only accessed from within a single function" }, "fullDescription": { "text": "Objects shall be defined at block scope if they are only accessed from within a single function [MISRAC2025-RULE_8_9-a]" }, "defaultConfiguration": { "level": "warning" }, "help": { "text": "Objects shall be defined at block scope if they are only accessed from within a single function [MISRAC2025-RULE_8_9-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 8.9 (Advisory) An object should be declared at block scope if its identifier only appears in a single function" ] } }, { "id": "MISRAC2025-RULE_21_24-a", "name": "The random number generator functions 'rand()' and 'srand()' should not be used", "shortDescription": { "text": "The random number generator functions 'rand()' and 'srand()' should not be used" }, "fullDescription": { "text": "The random number generator functions 'rand()' and 'srand()' should not be used [MISRAC2025-RULE_21_24-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The random number generator functions 'rand()' and 'srand()' should not be used [MISRAC2025-RULE_21_24-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 21.24 (Required) The random number generator functions of <stdlib.h> shall not be used" ] } }, { "id": "MISRAC2025-RULE_8_4-a", "name": "A declaration shall be visible when an object or function with external linkage is defined", "shortDescription": { "text": "A declaration shall be visible when an object or function with external linkage is defined" }, "fullDescription": { "text": "A declaration shall be visible when an object or function with external linkage is defined [MISRAC2025-RULE_8_4-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "A declaration shall be visible when an object or function with external linkage is defined [MISRAC2025-RULE_8_4-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 8.4 (Required) A compatible declaration shall be visible when an object or function with external linkage is defined" ] } }, { "id": "MISRAC2025-RULE_8_3-b", "name": "The identifiers used in the declaration and definition of a function shall be identical", "shortDescription": { "text": "The identifiers used in the declaration and definition of a function shall be identical" }, "fullDescription": { "text": "The identifiers used in the declaration and definition of a function shall be identical [MISRAC2025-RULE_8_3-b]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The identifiers used in the declaration and definition of a function shall be identical [MISRAC2025-RULE_8_3-b]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 8.3 (Required) All declarations of an object or function shall use the same names and type qualifiers" ] } }, { "id": "MISRAC2025-RULE_8_3-c", "name": "All declarations of an object or function shall have compatible types", "shortDescription": { "text": "All declarations of an object or function shall have compatible types" }, "fullDescription": { "text": "All declarations of an object or function shall have compatible types [MISRAC2025-RULE_8_3-c]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "All declarations of an object or function shall have compatible types [MISRAC2025-RULE_8_3-c]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 8.3 (Required) All declarations of an object or function shall use the same names and type qualifiers" ] } }, { "id": "MISRAC2025-RULE_8_2-a", "name": "Identifiers shall be given for all of the parameters in a function prototype declaration", "shortDescription": { "text": "Identifiers shall be given for all of the parameters in a function prototype declaration" }, "fullDescription": { "text": "Identifiers shall be given for all of the parameters in a function prototype declaration [MISRAC2025-RULE_8_2-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "Identifiers shall be given for all of the parameters in a function prototype declaration [MISRAC2025-RULE_8_2-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 8.2 (Required) Function types shall be in prototype form with named parameters" ] } }, { "id": "MISRAC2025-RULE_8_2-b", "name": "Function types shall have named parameters", "shortDescription": { "text": "Function types shall have named parameters" }, "fullDescription": { "text": "Function types shall have named parameters [MISRAC2025-RULE_8_2-b]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "Function types shall have named parameters [MISRAC2025-RULE_8_2-b]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 8.2 (Required) Function types shall be in prototype form with named parameters" ] } }, { "id": "MISRAC2025-RULE_8_2-c", "name": "Function types shall be in prototype form", "shortDescription": { "text": "Function types shall be in prototype form" }, "fullDescription": { "text": "Function types shall be in prototype form [MISRAC2025-RULE_8_2-c]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "Function types shall be in prototype form [MISRAC2025-RULE_8_2-c]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 8.2 (Required) Function types shall be in prototype form with named parameters" ] } }, { "id": "MISRAC2025-RULE_11_3-a", "name": "A cast shall not be performed between a pointer to object type and a pointer to a different object type", "shortDescription": { "text": "A cast shall not be performed between a pointer to object type and a pointer to a different object type" }, "fullDescription": { "text": "A cast shall not be performed between a pointer to object type and a pointer to a different object type [MISRAC2025-RULE_11_3-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "A cast shall not be performed between a pointer to object type and a pointer to a different object type [MISRAC2025-RULE_11_3-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 11.3 (Required) A conversion shall not be performed between a pointer to object type and a pointer to a different object type" ] } }, { "id": "MISRAC2025-RULE_11_4-b", "name": "A conversion should not be performed from an arithmetic type to a pointer type", "shortDescription": { "text": "A conversion should not be performed from an arithmetic type to a pointer type" }, "fullDescription": { "text": "A conversion should not be performed from an arithmetic type to a pointer type [MISRAC2025-RULE_11_4-b]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "A conversion should not be performed from an arithmetic type to a pointer type [MISRAC2025-RULE_11_4-b]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 11.4 (Required) A conversion shall not be performed between a pointer to object and an arithmetic type" ] } }, { "id": "MISRAC2025-RULE_11_5-b", "name": "A conversion should not be performed from pointer to void into pointer to object", "shortDescription": { "text": "A conversion should not be performed from pointer to void into pointer to object" }, "fullDescription": { "text": "A conversion should not be performed from pointer to void into pointer to object [MISRAC2025-RULE_11_5-b]" }, "defaultConfiguration": { "level": "warning" }, "help": { "text": "A conversion should not be performed from pointer to void into pointer to object [MISRAC2025-RULE_11_5-b]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 11.5 (Advisory) A conversion should not be performed from pointer to void into pointer to object" ] } }, { "id": "MISRAC2025-RULE_11_6-b", "name": "A conversion should not be performed from an arithmetic type to a pointer type", "shortDescription": { "text": "A conversion should not be performed from an arithmetic type to a pointer type" }, "fullDescription": { "text": "A conversion should not be performed from an arithmetic type to a pointer type [MISRAC2025-RULE_11_6-b]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "A conversion should not be performed from an arithmetic type to a pointer type [MISRAC2025-RULE_11_6-b]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 11.6 (Required) A cast shall not be performed between pointer to void and an arithmetic type" ] } }, { "id": "MISRAC2025-RULE_1_3-b", "name": "Avoid use before initialization", "shortDescription": { "text": "Avoid use before initialization" }, "fullDescription": { "text": "Avoid use before initialization [MISRAC2025-RULE_1_3-b]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "Avoid use before initialization [MISRAC2025-RULE_1_3-b]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 1.3 (Required) There shall be no occurrence of undefined or critical unspecified behaviour" ] } }, { "id": "MISRAC2025-RULE_1_3-n", "name": "The address of an object with automatic storage shall not be assigned to another object that may persist after the first object has ceased to exist", "shortDescription": { "text": "The address of an object with automatic storage shall not be assigned to another object that may persist after the first object has ceased to exist" }, "fullDescription": { "text": "The address of an object with automatic storage shall not be assigned to another object that may persist after the first object has ceased to exist [MISRAC2025-RULE_1_3-n]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The address of an object with automatic storage shall not be assigned to another object that may persist after the first object has ceased to exist [MISRAC2025-RULE_1_3-n]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 1.3 (Required) There shall be no occurrence of undefined or critical unspecified behaviour" ] } }, { "id": "MISRAC2025-RULE_1_1-a", "name": "A program should not exceed the translation limits imposed by The Standard (c90)", "shortDescription": { "text": "A program should not exceed the translation limits imposed by The Standard (c90)" }, "fullDescription": { "text": "A program should not exceed the translation limits imposed by The Standard (c90) [MISRAC2025-RULE_1_1-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "A program should not exceed the translation limits imposed by The Standard (c90) [MISRAC2025-RULE_1_1-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 1.1 (Required) The program shall contain no violations of the standard C syntax and constraints, and shall not exceed the implementation's translation limits" ] } }, { "id": "MISRAC2025-RULE_1_1-b", "name": "A program should not exceed the translation limits imposed by The Standard (c99)", "shortDescription": { "text": "A program should not exceed the translation limits imposed by The Standard (c99)" }, "fullDescription": { "text": "A program should not exceed the translation limits imposed by The Standard (c99) [MISRAC2025-RULE_1_1-b]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "A program should not exceed the translation limits imposed by The Standard (c99) [MISRAC2025-RULE_1_1-b]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 1.1 (Required) The program shall contain no violations of the standard C syntax and constraints, and shall not exceed the implementation's translation limits" ] } }, { "id": "MISRAC2025-RULE_1_1-c", "name": "A program should not exceed the translation limits imposed by The Standard (c90)", "shortDescription": { "text": "A program should not exceed the translation limits imposed by The Standard (c90)" }, "fullDescription": { "text": "A program should not exceed the translation limits imposed by The Standard (c90) [MISRAC2025-RULE_1_1-c]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "A program should not exceed the translation limits imposed by The Standard (c90) [MISRAC2025-RULE_1_1-c]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 1.1 (Required) The program shall contain no violations of the standard C syntax and constraints, and shall not exceed the implementation's translation limits" ] } }, { "id": "MISRAC2025-RULE_1_5-c", "name": "Function types shall be in prototype form", "shortDescription": { "text": "Function types shall be in prototype form" }, "fullDescription": { "text": "Function types shall be in prototype form [MISRAC2025-RULE_1_5-c]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "Function types shall be in prototype form [MISRAC2025-RULE_1_5-c]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 1.5 (Required) Obsolescent language features shall not be used" ] } }, { "id": "MISRAC2025-RULE_9_2-a", "name": "The initializer for an aggregate or union shall be enclosed in braces", "shortDescription": { "text": "The initializer for an aggregate or union shall be enclosed in braces" }, "fullDescription": { "text": "The initializer for an aggregate or union shall be enclosed in braces [MISRAC2025-RULE_9_2-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "The initializer for an aggregate or union shall be enclosed in braces [MISRAC2025-RULE_9_2-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 9.2 (Required) The initializer for an aggregate or union shall be enclosed in braces" ] } }, { "id": "MISRAC2025-RULE_9_1-a", "name": "Avoid use before initialization", "shortDescription": { "text": "Avoid use before initialization" }, "fullDescription": { "text": "Avoid use before initialization [MISRAC2025-RULE_9_1-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "Avoid use before initialization [MISRAC2025-RULE_9_1-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 9.1 (Mandatory) The value of an object with automatic storage duration shall not be read before it has been set" ] } }, { "id": "MISRAC2025-RULE_12_1-a", "name": "Use parentheses to indicate the precedence of operators in expressions", "shortDescription": { "text": "Use parentheses to indicate the precedence of operators in expressions" }, "fullDescription": { "text": "Use parentheses to indicate the precedence of operators in expressions [MISRAC2025-RULE_12_1-a]" }, "defaultConfiguration": { "level": "warning" }, "help": { "text": "Use parentheses to indicate the precedence of operators in expressions [MISRAC2025-RULE_12_1-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 12.1 (Advisory) The precedence of operators within expressions should be made explicit" ] } }, { "id": "MISRAC2025-RULE_11_11-a", "name": "Pointers shall not be implicitly compared to NULL", "shortDescription": { "text": "Pointers shall not be implicitly compared to NULL" }, "fullDescription": { "text": "Pointers shall not be implicitly compared to NULL [MISRAC2025-RULE_11_11-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "Pointers shall not be implicitly compared to NULL [MISRAC2025-RULE_11_11-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 11.11 (Required) Pointers shall not be implicitly compared to NULL" ] } }, { "id": "MISRAC2025-RULE_8_13-a", "name": "A pointer parameter in a function prototype should be declared as pointer to const if the pointer is not used to modify the addressed object", "shortDescription": { "text": "A pointer parameter in a function prototype should be declared as pointer to const if the pointer is not used to modify the addressed object" }, "fullDescription": { "text": "A pointer parameter in a function prototype should be declared as pointer to const if the pointer is not used to modify the addressed object [MISRAC2025-RULE_8_13-a]" }, "defaultConfiguration": { "level": "warning" }, "help": { "text": "A pointer parameter in a function prototype should be declared as pointer to const if the pointer is not used to modify the addressed object [MISRAC2025-RULE_8_13-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 8.13 (Advisory) A pointer should point to a const-qualified type whenever possible" ] } }, { "id": "MISRAC2025-RULE_8_19-b", "name": "Functions with external linkage should not be declared in implementation files", "shortDescription": { "text": "Functions with external linkage should not be declared in implementation files" }, "fullDescription": { "text": "Functions with external linkage should not be declared in implementation files [MISRAC2025-RULE_8_19-b]" }, "defaultConfiguration": { "level": "warning" }, "help": { "text": "Functions with external linkage should not be declared in implementation files [MISRAC2025-RULE_8_19-b]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 8.19 (Advisory) There should be no external declarations in a source file" ] } }, { "id": "MISRAC2025-RULE_8_19-c", "name": "Objects with external linkage should not be declared in implementation files", "shortDescription": { "text": "Objects with external linkage should not be declared in implementation files" }, "fullDescription": { "text": "Objects with external linkage should not be declared in implementation files [MISRAC2025-RULE_8_19-c]" }, "defaultConfiguration": { "level": "warning" }, "help": { "text": "Objects with external linkage should not be declared in implementation files [MISRAC2025-RULE_8_19-c]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 8.19 (Advisory) There should be no external declarations in a source file" ] } }, { "id": "MISRAC2025-RULE_17_12-a", "name": "A function identifier shall only be used with either a preceding '&', or with a parenthesised parameter list, which may be empty", "shortDescription": { "text": "A function identifier shall only be used with either a preceding '&', or with a parenthesised parameter list, which may be empty" }, "fullDescription": { "text": "A function identifier shall only be used with either a preceding '&', or with a parenthesised parameter list, which may be empty [MISRAC2025-RULE_17_12-a]" }, "defaultConfiguration": { "level": "warning" }, "help": { "text": "A function identifier shall only be used with either a preceding '&', or with a parenthesised parameter list, which may be empty [MISRAC2025-RULE_17_12-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 17.12 (Advisory) A function identifier should only be used with either a preceding &, or with a parenthesized parameter list" ] } }, { "id": "MISRAC2025-DIR_4_6-b", "name": "The names of standard signed integer types and standard unsigned integer types should not be used", "shortDescription": { "text": "The names of standard signed integer types and standard unsigned integer types should not be used" }, "fullDescription": { "text": "The names of standard signed integer types and standard unsigned integer types should not be used [MISRAC2025-DIR_4_6-b]" }, "defaultConfiguration": { "level": "warning" }, "help": { "text": "The names of standard signed integer types and standard unsigned integer types should not be used [MISRAC2025-DIR_4_6-b]" }, "properties": { "tags": [ "MISRA C 2025", "Dir 4.6 (Advisory) typedefs that indicate size and signedness should be used in place of the basic integer types" ] } }, { "id": "MISRAC2025-DIR_4_7-a", "name": "Consistently check the returned value of non-void functions", "shortDescription": { "text": "Consistently check the returned value of non-void functions" }, "fullDescription": { "text": "Consistently check the returned value of non-void functions [MISRAC2025-DIR_4_7-a]" }, "defaultConfiguration": { "level": "error" }, "help": { "text": "Consistently check the returned value of non-void functions [MISRAC2025-DIR_4_7-a]" }, "properties": { "tags": [ "MISRA C 2025", "Dir 4.7 (Required) If a function returns error information, then that error information shall be tested" ] } }, { "id": "MISRAC2025-DIR_4_9-a", "name": "A function should be used in preference to a function-like macro", "shortDescription": { "text": "A function should be used in preference to a function-like macro" }, "fullDescription": { "text": "A function should be used in preference to a function-like macro [MISRAC2025-DIR_4_9-a]" }, "defaultConfiguration": { "level": "warning" }, "help": { "text": "A function should be used in preference to a function-like macro [MISRAC2025-DIR_4_9-a]" }, "properties": { "tags": [ "MISRA C 2025", "Dir 4.9 (Advisory) A function should be used in preference to a function-like macro where they are interchangeable" ] } }, { "id": "MISRAC2025-RULE_13_3-a", "name": "A full expression containing an increment (++) or decrement (--) operator should have no other potential side effects", "shortDescription": { "text": "A full expression containing an increment (++) or decrement (--) operator should have no other potential side effects" }, "fullDescription": { "text": "A full expression containing an increment (++) or decrement (--) operator should have no other potential side effects [MISRAC2025-RULE_13_3-a]" }, "defaultConfiguration": { "level": "warning" }, "help": { "text": "A full expression containing an increment (++) or decrement (--) operator should have no other potential side effects [MISRAC2025-RULE_13_3-a]" }, "properties": { "tags": [ "MISRA C 2025", "Rule 13.3 (Advisory) A full expression containing an increment (++) or decrement (--) operator should have no other potential side effects other than that caused by the increment or decrement operator" ] } }, { "id": "MISRAC2025-DIR_4_4-a", "name": "Sections of code should not be \"commented out\"", "shortDescription": { "text": "Sections of code should not be \"commented out\"" }, "fullDescription": { "text": "Sections of code should not be \"commented out\" [MISRAC2025-DIR_4_